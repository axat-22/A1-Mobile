<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="index.master.cs" Inherits="A1Mobile.Seller.index" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <link rel="stylesheet" href="../css/plugins/overlayScrollbars/css/all.min.css">
    <title></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="../css/plugins/fontawesome-free/css/all.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="../css/dist/css/adminlte.min.css">
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    <!-- overlayScrollbars -->
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="hold-transition sidebar-mini" data-panel-auto-height-mode="height">
    <form id="form1" runat="server">
        <div class="wrapper d-flex flex-column min-vh-100">
            <!-- Navbar -->
            <nav class="main-header navbar navbar-expand navbar-white navbar-light">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <a href="index3.html" class="nav-link"></a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <a href="#" class="nav-link"></a>
                    </li>
                </ul>  
                <ul class="navbar-nav ml-auto"></ul>
                <asp:Label ID="lb" runat="server" Text=""></asp:Label>
                <asp:Button ID="Btn" runat="server" class="btn btn-primary" Text="Log Out" OnClick="Btn_Click" />
            </nav>

            <!-- Sidebar -->
            <aside class="main-sidebar sidebar-dark-primary elevation-4">
                <div class="sidebar">
                    <div class=" mt-3 pb-3 mb-3 d-flex">
                        <div class="image"></div>
                        <div class="info">
                            <a href="#" class="d-block">
                                <h1>A1 Mobile</h1>
                            </a>
                        </div>
                    </div>
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                            <li class="nav-item">
                                <a href="Dashboard.aspx" class="nav-link">
                                    <p>Dashboard</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="product-list.aspx" class="nav-link">
                                    <p>Product</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="profile.aspx" class="nav-link">
                                    <p>Profile</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="Orders.aspx" class="nav-link">
                                    <p>Orders</p>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </aside>

            
            <!-- Page Content -->
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />

            <!-- Footer -->
            <footer class="main-footer mt-auto">
                <div class="container text-center">
                    <strong>Copyright &copy; 2025 A1 Mobile.</strong>
                    All rights reserved.
                    <div class="float-right d-none d-sm-inline-block">
                        <b>Version</b> 3.2.0
                    </div>
                </div>
            </footer>
                
            
        

        </div>
        
    </form>
    
    <!-- Scripts -->
    <script src="../js/jquery/jquery.min.js"></script>
    <script src="../js/jquery-ui/jquery-ui.min.js"></script>
    <script src="../js/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="../js/dist/js/adminlte.js"></script>

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        .wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-footer {
            background: #f8f9fa;
            padding: 10px 0;
            text-align: center;
        }

        .content-wrapper {
            flex: 1;
        }
    </style>
</body>
</html>
